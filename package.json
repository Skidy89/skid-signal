{
  "name": "@skidy89/signal-protocol",
  "version": "0.0.1",
  "description": "Signal Protocol native Rust (X3DH + Double Ratchet) — MIT replacement for libsignal (GPL). E2EE engine for WhatsApp Multi-Device.",
  "keywords": [
    "signal"
  ],
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/Skidy89/skid-signal#readme",
  "bugs": {
    "url": "https://github.com/Skidy89/skid-signal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skidy89/skid-signal.git"
  },
  "license": "MIT",
  "author": "skidy89",
  "maintainers": [
    "skidy89"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "files": [
    "dist",
    "native"
  ],
  "scripts": {
    "build:native": "napi build --release --platform --js-package-name @skidy89/signal --config-path napi.config.json --manifest-path signal/Cargo.toml --output-dir native/ --js index.js",
    "test": "npx jest",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.8",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "libsignal": "github:WhiskeySockets/libsignal-node",
    "protobufjs-cli": "^2.7.1"
  },
  "dependencies": {
    "msgpackr": "^2.1.1",
    "protobufjs": "^8.8.1",
    "typescript": "^7.0.2"
  }
}
