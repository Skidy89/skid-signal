{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "lib": ["ES2020", "ESNext.Array", "DOM", "ES2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "noImplicitThis": true,
    "rootDir": "src",
    "outDir": "dist",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES2019",
    "noUnusedParameters": false,
  },
  "include": ["src/**/*", "types/**/*.d.ts", "native/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}